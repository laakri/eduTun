// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ------------------------------------------------------------
// AUTH TABLES (NextAuth / Auth.js)
// Not written to under the current JWT session strategy, but
// required scaffolding for adding an OAuth provider later
// without a schema change.
// ------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------------------------------------
// USERS & ROLES
// passwordHash and fullName are required here — register/route.ts
// writes both, and auth.ts reads passwordHash to verify login.
// Removing them without also changing that code will crash at runtime.
// ------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  fullName     String
  phone        String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts        Account[]
  sessions        Session[]
  roles           UserRole[]
  coursesTaught   Course[]         @relation("ProfCourses")
  profApplications ProfApplication[] @relation("ApplicantApplications")
  reviewedProfApplications ProfApplication[] @relation("ApplicationReviewer")
  packEnrollments PackEnrollment[]
  progress        VideoProgress[]
  quizAttempts    QuizAttempt[]
  pfeListings     PfeListing[]     @relation("CompanyListings")
  pfeApplications PfeApplication[]
}

model Role {
  id          String     @id @default(cuid())
  slug        String     @unique
  displayName String
  users       UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// ------------------------------------------------------------
// CATEGORY — generic, self-referencing. Your version, unchanged.
// Bac, PFE, Coding, Languages — all rows, nested via parentId.
// ------------------------------------------------------------

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")

  courses     CourseCategory[]
  pfeListings PfeListing[]
  packItems   PackItem[]
  profApplications ProfApplicationCategory[]
}

model Tag {
  id      String      @id @default(cuid())
  slug    String      @unique
  name    String
  courses CourseTag[]
}

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

model CourseTag {
  courseId String
  tagId    String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([courseId, tagId])
}

// ------------------------------------------------------------
// COURSES, CHAPTERS (VIDEOS), QUIZZES
// ------------------------------------------------------------

model Course {
  id            String   @id @default(cuid())
  title         String
  description   String?
  // Author / owner. Named profId for historical reasons — any course-manager
  // role (prof, admin, …) can create; access checks use roles + ownership.
  profId        String
  coverImageKey String?
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  prof       User             @relation("ProfCourses", fields: [profId], references: [id])
  categories CourseCategory[]
  tags       CourseTag[]
  chapters   Chapter[]
  packItems  PackItem[]
}

model CourseCategory {
  courseId   String
  categoryId String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([courseId, categoryId])
}

model Chapter {
  id              String  @id @default(cuid())
  courseId        String
  title           String
  description     String?
  order           Int
  videoProvider   String // "bunny" | "youtube"
  videoId         String
  durationSeconds Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  ready Boolean @default(false)
  videoStatus VideoStatus @default(PROCESSING)
  
  course    Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress  VideoProgress[]
  quiz      Quiz?
  sections  VideoSection[]
  resources ChapterResource[]
}

// Timestamp labels inside a chapter video (e.g. 0–5m = Introduction).
// Source of truth in our DB; synced to Bunny Stream chapters on save.
model VideoSection {
  id           String @id @default(cuid())
  chapterId    String
  title        String
  startSeconds Int
  endSeconds   Int
  order        Int

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
}

// Files attached to a chapter (PDFs, notes, …) stored in Bunny Storage.
model ChapterResource {
  id          String   @id @default(cuid())
  chapterId   String
  title       String
  kind        String   // "pdf" | future kinds as plain strings
  storageKey  String
  sizeBytes   Int?
  contentType String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
}

model VideoProgress {
  id             String   @id @default(cuid())
  userId         String
  chapterId      String
  watchedSeconds Int      @default(0)
  completed      Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
}

model Quiz {
  id        String @id @default(cuid())
  chapterId String @unique
  title     String

  chapter   Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]
}

model Question {
  id      String   @id @default(cuid())
  quizId  String
  prompt  String
  order   Int
  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers Answer[]
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean  @default(false)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  quizId    String
  score     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------
// PACK — bundles Categories and/or Courses as data.
// PackItem holds exactly one of courseId/categoryId — enforce
// that in your service layer; Prisma has no native CHECK constraint.
// ------------------------------------------------------------

model Pack {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  priceCents  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items PackItem[]
  enrollments PackEnrollment[]
}

model PackItem {
  id         String  @id @default(cuid())
  packId     String
  courseId   String?
  categoryId String?

  pack     Pack      @relation(fields: [packId], references: [id], onDelete: Cascade)
  course   Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([packId, courseId])
  @@unique([packId, categoryId])
}

// A purchase or a complimentary/admin grant. Payments will create these rows;
// content checks only consult this model, never a client-side flag.
model PackEnrollment {
  id        String   @id @default(cuid())
  userId    String
  packId    String
  status    String   @default("active") // active | revoked | refunded
  source    String   @default("manual") // manual | payment | complimentary
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack Pack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@unique([userId, packId])
  @@index([userId, status])
}

// Applying does not grant the professor role. An admin must explicitly
// approve the application, at which point the service adds the prof role.
model ProfApplication {
  id                    String   @id @default(cuid())
  applicantId           String
  fullName              String
  dateOfBirth           DateTime
  phone                 String
  institution           String
  institutionType       String
  experienceRange       String
  qualification         String
  message               String
  identityDocumentKey   String
  qualificationProofKey String
  status                String   @default("pending") // pending | approved | rejected
  reviewNote            String?
  reviewedById          String?
  reviewedAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  applicant User @relation("ApplicantApplications", fields: [applicantId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  categories ProfApplicationCategory[]

  @@index([status, createdAt])
  @@index([applicantId, status])
}

// An applicant may be verified for more than one category without coupling
// the application workflow to a Bac-specific set of columns.
model ProfApplicationCategory {
  applicationId String
  categoryId    String

  application ProfApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  category    Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([applicationId, categoryId])
}

// ------------------------------------------------------------
// PFE MODULE
// status stays a plain string on purpose (see PROJECT_RULES.md §3).
// ------------------------------------------------------------

model PfeListing {
  id          String   @id @default(cuid())
  companyId   String
  categoryId  String
  title       String
  description String
  location    String?
  createdAt   DateTime @default(now())

  company      User             @relation("CompanyListings", fields: [companyId], references: [id])
  category     Category         @relation(fields: [categoryId], references: [id])
  applications PfeApplication[]
}

model PfeApplication {
  id        String   @id @default(cuid())
  listingId String
  studentId String
  status    String   @default("pending") // "pending" | "accepted" | "rejected"
  createdAt DateTime @default(now())

  listing PfeListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  student User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([listingId, studentId])
}
